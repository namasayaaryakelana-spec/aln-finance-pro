rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Wallets collection
    match /wallets/{walletId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(walletId)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().balance is number;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(transactionId)
        && incoming().userId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().amount is number;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // User document and subcollections store for real-time auto sync
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Test connection document for initialization checks
    match /test/connection {
      allow read: if true;
    }
  }
}
